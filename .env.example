# Copia este archivo como .env y completa los valores. El .env nunca se sube a git.

# PostgreSQL (Neon, región São Paulo). Usa la cadena con "-pooler".
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Clave larga y aleatoria para firmar sesiones del panel.
PAYLOAD_SECRET=CAMBIAR_POR_UNA_CLAVE_ALEATORIA

# URL pública del sitio, sin barra final (canonical, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 (opcional en desarrollo: sin esto las imágenes se guardan en ./media)
R2_BUCKET=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dominio propio del bucket, p. ej. https://img.whatice.com
R2_PUBLIC_URL=
